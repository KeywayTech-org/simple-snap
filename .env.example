# LLM_API_KEY: 解读阶段视觉大模型（OpenAI 兼容 chat completions）
LLM_API_KEY=""
LLM_BASE_URL="https://api.xkiro.com/v1"
LLM_MODEL="minimax/minimax-m3:free"

# IMAGE_API_KEY: 生图服务（new-api 通道，OpenAI 兼容 images API）
IMAGE_API_KEY=""
